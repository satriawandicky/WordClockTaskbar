<Window x:Class="WordClockTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WordClockTaskbar.ViewModels"
        Title="WorldClock"
        Height="36"
        Width="180"
        MinWidth="80"
        MaxWidth="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.DataContext>
        <vm:ClockViewModel/>
    </Window.DataContext>

    <Border x:Name="RootBorder"
            CornerRadius="6"
            BorderBrush="{DynamicResource ChromeBorderColor}"
            BorderThickness="1"
            Padding="8,1">
        <ItemsControl ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="6,0">
                        <!-- Top Clock -->
                        <ContentControl Content="{Binding TopClock}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Height="15"
                                                ToolTip="{Binding GMTOffset}">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource LabelColor}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.75"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Time}"
                                                   Foreground="{DynamicResource ForegroundColor}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Bottom Clock -->
                        <ContentControl Content="{Binding BottomClock}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BottomClock}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Height="15"
                                                ToolTip="{Binding GMTOffset}">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource LabelColor}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.75"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Time}"
                                                   Foreground="{DynamicResource ForegroundColor}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
