<Window x:Class="WordClockTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WordClockTaskbar.ViewModels"
        Title="WorldClock"
        Width="548" Height="32"
        MinWidth="300"
        MaxWidth="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.DataContext>
        <vm:ClockViewModel/>
    </Window.DataContext>

    <Border x:Name="RootBorder"
            CornerRadius="6"
            BorderBrush="{DynamicResource ChromeBorderColor}"
            BorderThickness="1"
            Padding="10,0">
        <ItemsControl ItemsSource="{Binding Timezones}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="24"
                          MinWidth="88"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          ToolTip="{Binding GMTOffset}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{DynamicResource LabelColor}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Opacity="0.62"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="24"
                                   Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Emoji}"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Time}"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
