<Window x:Class="WordClockTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WordClockTaskbar.ViewModels"
        Title="WorldClock"
        Width="548" Height="32"
        MinWidth="300"
        MaxWidth="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.DataContext>
        <vm:ClockViewModel/>
    </Window.DataContext>

    <Border x:Name="RootBorder"
            CornerRadius="6"
            BorderBrush="{DynamicResource ChromeBorderColor}"
            BorderThickness="1"
            Padding="10,0">
        <ItemsControl ItemsSource="{Binding Timezones}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="24"
                          MinWidth="88"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          ToolTip="{Binding GMTOffset}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                            <Image Source="{Binding Flag}"
                                   Height="13"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Aliased">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFlag}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{DynamicResource LabelColor}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Opacity="0.62"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="24">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFlag}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Emoji}"
                                   Foreground="{Binding EmojiBrush}"
                                   FontFamily="Segoe UI Symbol, Segoe UI"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Time}"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
