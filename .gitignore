## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][In][32]/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Vv][Ss][Pp][Ss][Cc][Cc]/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the TestResults folder
#TestResults/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build log of MSBuild
*.log

# Visual Studio analyzer solutions
*.Cache
VisualStudio.Queries.Tests.Queries.Visualizer.Debug.ReadOnly.v1.cache

# _Chutzpah*

# Visual Studio 2015/2017 lingering (Gulp, Grunt)
node_modules/
bower_components/

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet 2.x to load packages into the solution root directory
# !packages/

# Microsoft Azure Build Output
csx/
*.build.csdef

# Code Analysis results
DotNetSelectors.xml
*.cdxml
*.cdxml.config

# Node.js
node_modules/

# Python
__pycache__/
*.pyc

# Backup & temp files from Microsoft Office
$~*
