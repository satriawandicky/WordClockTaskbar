<Window x:Class="WordClockTaskbar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WordClockTaskbar.ViewModels"
        Title="WordClock Settings"
        Width="720" Height="660"
        MinWidth="640" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.DataContext>
        <vm:SettingsViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Timezone List -->
        <GroupBox Header="Timezones (max 4, labels max 3 letters)" Padding="12" Margin="0,0,0,12" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox ItemsSource="{Binding Timezones}"
                         x:Name="TimezonListBox"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="3"
                                         CharacterCasing="Upper"
                                         Padding="4" Height="24" Margin="0,0,8,0"/>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AvailableTimezones}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding TimezoneId}"
                                          Padding="4" Height="24" Margin="0,0,8,0"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="↑" Width="28" Height="24" Margin="0,0,4,0"
                                            Click="MoveUpButton_Click" Padding="0"/>
                                    <Button Content="↓" Width="28" Height="24" Margin="0,0,4,0"
                                            Click="MoveDownButton_Click" Padding="0"/>
                                    <Button Content="✕" Width="28" Height="24"
                                            Click="RemoveButton_Click" Padding="0" Foreground="Red"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Add New Button -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="Add Timezone" Padding="12,8" Click="AddButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Window Options -->
        <GroupBox Header="Window Options" Padding="12" Margin="0,0,0,12" Grid.Row="1">
            <StackPanel>
                <CheckBox Content="Always on Top"
                          IsChecked="{Binding IsAlwaysOnTop, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center"/>
                <TextBlock Text="Tip: right-click or double-click the widget to open these settings."
                           Opacity="0.65" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- UTC Converter -->
        <GroupBox Header="UTC Time Converter" Padding="12" Margin="0,0,0,12" Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="UTC date/time:" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <TextBox x:Name="UtcInputTextBox"
                         Grid.Column="1"
                         Padding="6,4"
                         Margin="0,0,8,8"
                         ToolTip="Format: yyyy-MM-dd HH:mm"/>
                <Button Grid.Column="2"
                        Content="Use UTC Now"
                        Padding="12,5"
                        Margin="0,0,0,8"
                        Click="UseUtcNowButton_Click"/>

                <TextBlock Grid.Row="1" Text="Target timezone:" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <ComboBox x:Name="ConverterTimezoneComboBox"
                          Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          ItemsSource="{Binding AvailableTimezones}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"
                          Padding="4" Margin="0,0,0,8"/>

                <Button Grid.Row="2"
                        Content="Convert"
                        Padding="16,6"
                        HorizontalAlignment="Left"
                        Click="ConvertUtcButton_Click"/>
                <TextBlock x:Name="ConversionResultTextBlock"
                           Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Enter a UTC time and select the destination timezone."/>
            </Grid>
        </GroupBox>

        <!-- Theme Settings -->
        <GroupBox Header="Theme Colors" Padding="12" Margin="0,0,0,12" Grid.Row="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Background:" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <TextBox Grid.Column="1" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" Padding="4" Height="24" Margin="0,0,0,8"/>

                <TextBlock Text="Text Color:" VerticalAlignment="Center" Margin="0,0,12,8" Grid.Row="1"/>
                <TextBox Grid.Column="1" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Padding="4" Height="24" Margin="0,0,0,8" Grid.Row="1"/>

                <TextBlock Text="Label Color:" VerticalAlignment="Center" Margin="0,0,12,0" Grid.Row="2"/>
                <TextBox Grid.Column="1" Text="{Binding LabelColor, UpdateSourceTrigger=PropertyChanged}" Padding="4" Height="24" Grid.Row="2"/>
            </Grid>
        </GroupBox>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="20,8" IsCancel="True" Width="100" Margin="0,0,8,0"/>
            <Button Content="Save" Padding="20,8" Click="SaveButton_Click" Width="100" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
